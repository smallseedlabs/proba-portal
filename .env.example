# Copy to .env.local for local development. Never commit real values.

# Base URL of the audit API (proba-audit, apps/audit-api).
VITE_API_BASE_URL=http://localhost:3100

# Firebase Authentication web app config: the same project proba-web and proba-hub use
# (Firebase console > Project settings > General > Your apps > Web app). These identify the
# project to the browser and are not secrets, but keep real values in .env.local, not in the repository.
# Sign-in shows "temporarily unavailable" until all four are set.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Optional: address of the Proba memory console. When set, a "Memory" entry opens it from the
# navigation; when empty there is no Memory entry at all.
VITE_MEMORY_URL=

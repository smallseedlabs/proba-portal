# Copy to .env.local for `npm run dev`, or to .env for `docker compose up`. Never commit real values.

# --- npm run dev (Vite reads VITE_* from .env.local) -------------------------------------------

# Base URL of the audit API (proba-audit, apps/audit-api).
VITE_API_BASE_URL=http://localhost:3100

# Firebase Authentication web app config: the same project proba-web and proba-hub use
# (Firebase console > Project settings > General > Your apps > Web app). These identify the
# project to the browser and are not secrets, but keep real values in .env.local, not in the repository.
# Sign-in is not available until all four are set.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
LOG_LEVEL=info
LOG_SINK=console

# Optional: address of the Proba memory console. When set, a "Memory" entry opens it from the
# navigation; when empty there is no Memory entry at all.
VITE_MEMORY_URL=

# Browser logging: structured JSON lines (event, traceId, sessionId) on the console.
# VITE_LOG_LEVEL is debug | info | warn | error | silent; VITE_LOG_SINK is console | none.
VITE_LOG_LEVEL=info
VITE_LOG_SINK=console

# --- docker compose up (the container writes these into env-config.js when it starts) -----------

# Host port the portal is served on.
PORTAL_HOST_PORT=3410
# Where the browser reaches the audit API (the local Proba stack publishes it on 3400).
API_BASE_URL=http://localhost:3400
MEMORY_URL=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_APP_ID=
LOG_LEVEL=info
LOG_SINK=console
